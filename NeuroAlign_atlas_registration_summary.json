      "remove_small_line_objects": 0,
      "barrier_radius": 1,
      "min_region_area": 300,
      "simplify_epsilon_ratio": 0.001,
      "midline_tol": 8,
      "midline_sample_count": 32,
      "midline_search_half_width": 28
