      "assign_region_ids",
      "build_brain_outer_polygon",
      "build_midline_polyline",
      "保存 mask / 预览图 / atlas JSON"
    ],
    "cli_defaults": {
      "line_threshold": 180,
      "line_close_radius": 0,
      "detect_dark_lines": false,
      "auto_gap_close_radius": 1,
      "auto_gap_bridge_dist": 8,
