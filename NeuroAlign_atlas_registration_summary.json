    "goal": "从黑底白线的标准脑图谱图像中提取封闭区域，生成 atlas_regions_raw.json 和配套预览图。",
    "input_requirements": [
      "黑色背景",
      "白色区域边界线",
      "尽量不要带文字或额外标注",
      "边界线尽量闭合、连续、清晰"
    ],
    "main_pipeline": [
