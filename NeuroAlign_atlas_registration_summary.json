      "atlas_preview_filled.png",
      "atlas_regions_raw.json",
      "region_name_mapping_template.json",
      "atlas_regions_named.json (optional)"
    ],
    "atlas_json_schema": {
      "top_level_keys": [
        "image_width",
        "image_height",
        "midline_x",
        "brain_outer_polygon",
        "midline_polyline",
        "regions"
      ],
      "region_keys": [
        "id",
        "name",
        "hemisphere",
        "centroid",
        "bbox",
        "area",
        "polygon"
      ]
    },
    "accuracy_notes": [
      "这一步对 line_threshold、barrier_radius、gap bridging 最敏感。",
      "白线有断点时会导致区域碎裂；屏障过厚时会把相邻脑区粘住。",
      "atlas 原图越干净、越高对比，后面的注册越稳定。"
    ]
  },
